# Environment Variables Template
# Copy this file to .env and fill in your actual values.
# DO NOT commit your actual .env file to git!

# Active Season Override (Optional, default is 2026-2027)
FPL_SEASON=2026-2027

# Active Mini-League IDs
LEAGUE_ID_IFC=
LEAGUE_ID_RPK=
LEAGUE_ID_RBSC=

# Optional FPL Credentials (Only if accessing private endpoints)
# FPL_USER=your_email@example.com
# FPL_PASSWORD=your_password
